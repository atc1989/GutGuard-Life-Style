# Change 1: Preview and local should use GutGuard Staging Auth — the same
# project as GEMA Staging. Do not point Production at Staging.
# Staging URL: https://fxdsnacuonfvutdquogb.supabase.co
# Paste the Staging anon/publishable key from the dashboard. Never commit keys.

# Public — safe in the browser
NEXT_PUBLIC_SUPABASE_URL=https://fxdsnacuonfvutdquogb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave the anon key blank to use the localStorage mock session.
# Fill URL + anon/publishable key to enable email/password Auth.
# When those vars are set, localStorage is not authorization.

# Server only — never expose as NEXT_PUBLIC_
# Vercel: Preview (Staging) and Production (later). Not used by the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OneGrinders username login (Change 2). Server / Vercel only — never NEXT_PUBLIC_.
# Preview needs this for username sign-in. Email + password works without it.
ONEGRINDERS_API_KEY=
# Optional. Defaults to https://onegrindersguild.ph/api/v1/auth/login.php
# ONEGRINDERS_LOGIN_URL=
