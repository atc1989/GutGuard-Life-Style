# Public — safe in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave the two Supabase public vars blank to use the localStorage UI fallback.
# Fill them to enable cookie Auth (signUp) + member persistence (see README).
# `/app` is refused without a Supabase cookie when these are set.
# `/admin` is refused unless lifestyle_is_admin() is true when these are set.

# Server only — never expose as NEXT_PUBLIC_
# Vercel: Production + Preview. Not used by the browser.
# Required for /admin desks to list every member, order, and story (RLS is own-row).
SUPABASE_SERVICE_ROLE_KEY=

# Server only — payment webhooks. Never NEXT_PUBLIC_.
# HMAC for bank callbacks (and Maya if they send a signature later).
PAYMENTS_WEBHOOK_SECRET=
# Comma-separated IPs. Maya Checkout production: 18.138.50.235, 3.1.207.200
# Sandbox: 13.229.160.234, 3.1.199.75
PAYMENTS_WEBHOOK_IPS=
# Local curl only. Do not set in production.
# PAYMENTS_WEBHOOK_ALLOW_INSECURE=1
