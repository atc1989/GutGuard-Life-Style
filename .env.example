# Change 1: Preview and local should use GutGuard Staging Auth — the same
# project as GEMA Staging. Do not point Production at Staging.
# Staging URL: https://fxdsnacuonfvutdquogb.supabase.co
# Paste the Staging anon/publishable key from the dashboard. Never commit keys.

# Public — safe in the browser
NEXT_PUBLIC_SUPABASE_URL=https://fxdsnacuonfvutdquogb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Change 4c — one registration (D13). Account creation lives here; a member who
# starts on a spoke is sent back to it afterwards. These are the ONLY origins a
# `?returnTo=` may name — the check is exact, so a value that is blank, wrong,
# or missing means members land on the door card instead. Set them per
# environment (Preview -> the spokes' Preview URLs, Production -> Production).
NEXT_PUBLIC_ACADEMY_URL=http://localhost:3001
NEXT_PUBLIC_GEMA_URL=http://localhost:3002

# Leave the anon key blank to use the localStorage mock session.
# Fill URL + anon/publishable key to enable email/password Auth.
# When those vars are set, localStorage is not authorization.

# Server only — never expose as NEXT_PUBLIC_
# Vercel: Preview (Staging) and Production (later). Not used by the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Change 2 — shared login (One Account). Server only, never NEXT_PUBLIC_.
# Without these, email + password still works and only the OneGrinders
# username half of the login is off.
# SUPABASE_SERVICE_ROLE_KEY above is required for username sign-in.
ONEGRINDERS_API_KEY=
# Optional endpoint override; defaults to the guild's production login API.
# ONEGRINDERS_LOGIN_URL=
# Optional; defaults to `gema`. The schema holding the identity spine.
# ONE_ACCOUNT_IDENTITY_SCHEMA=gema

# Maya webhook HMAC secret (server only). Header: x-maya-signature
# Leave blank until Maya is live — unsigned callbacks return 401.
MAYA_WEBHOOK_SECRET=
